# Server
PORT=4100

# --- Email channel (Gmail SMTP) ---
# Create an "App Password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=

# --- WhatsApp channel ---
# mock  = simulated sending, no account needed (default, used for demos/dev)
# twilio / meta = real providers, drop in the matching keys below and flip this
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# --- SMS channel ---
# mock = simulated sending, no account needed (default)
SMS_PROVIDER=mock
TWILIO_SMS_FROM=
