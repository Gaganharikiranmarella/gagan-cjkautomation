{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lead-gen-agent",
      "runtimeExecutable": "node",
      "runtimeArgs": ["lead-gen-agent/backend/server.js"],
      "port": 4100
    },
    {
      "name": "recruitment-agent",
      "runtimeExecutable": "node",
      "runtimeArgs": ["recruitment-agent/backend/server.js"],
      "port": 3020
    },
    {
      "name": "whatsapp-agent-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "whatsapp-agent/frontend", "run", "dev", "--", "-p", "3010"],
      "port": 3010
    },
    {
      "name": "scas-backend",
      "runtimeExecutable": "E:/scas/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "E:/scas/backend", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "scas-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "E:/scas/frontend", "run", "dev", "--", "--host"],
      "port": 5173
    }
  ]
}
