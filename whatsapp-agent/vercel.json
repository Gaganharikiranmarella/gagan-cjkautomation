{
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/api/index.py", "use": "@vercel/python", "config": { "maxLambdaSize": "50mb" } }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/dispatch", "schedule": "0 * * * *" }
  ]
}
