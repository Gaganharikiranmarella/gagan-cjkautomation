# Copy to .env.local for local frontend dev. Next.js only reads NEXT_PUBLIC_*
# vars from this file — the backend's own .env (in ../backend or repo root)
# is separate. In Vercel, set NEXT_PUBLIC_META_APP_ID at the project level
# instead (see ../.env.example) and this file isn't needed.

# Optional — only needed to enable the one-click "Connect with Facebook"
# Embedded Signup button. Leave blank to use the manual connect flow, which
# needs zero Meta App Review and works immediately.
NEXT_PUBLIC_META_APP_ID=
