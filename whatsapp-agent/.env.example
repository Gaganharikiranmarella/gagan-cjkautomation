# ============================================================================
# WhatsApp Lead Agent — environment variables
# Copy this file to ".env" for local dev. In Vercel, add every one of these
# under Project Settings -> Environment Variables (see README.md "Deploy").
# NEVER commit the real ".env" file — it is already covered by .gitignore.
# ============================================================================

# ---- Database (Postgres — Neon/Supabase recommended, both work great with Vercel) ----
# Get this from https://neon.tech (free tier) or https://supabase.com -> Project Settings -> Database
# Must be the "pooled"/"pgbouncer" connection string if your provider offers one.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---- Auth ----
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts WhatsApp access tokens before they are stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-fernet-key

# ---- Claude (Anthropic) — powers language detection, reply drafting & CSV mapping ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# ---- WhatsApp Cloud API (Meta) ----
# From https://developers.facebook.com -> your App -> WhatsApp -> API Setup
# These are the DEFAULTS used only for local testing with Meta's test number;
# each tenant's real credentials are entered from the dashboard "Connect WhatsApp" screen
# and stored (encrypted) in the waba_accounts table instead.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-meta-app-dashboard
META_APP_SECRET=your-meta-app-secret
# Optional — only needed if you want the one-click "Embedded Signup" flow (Meta App Review
# required for production use). Leave blank to use the manual "paste your credentials" connect
# flow instead, which works instantly with no app review.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ---- Email (Resend — used for qualified-lead alerts + the support/complaint box) ----
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=re_your-key-here
EMAIL_FROM="WhatsApp Lead Agent <alerts@yourdomain.com>"
SUPPORT_EMAIL=ghk7125@gmail.com

# ---- Cron protection ----
# Any long random string; sent as a Bearer token by Vercel Cron / your external scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# ---- CORS / URLs ----
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
